# Database connection: DATABASE_URL takes precedence over the individual values.
DATABASE_URL=postgresql://postgres:test@localhost:5432/bracketballer_dev
PSQL_USER=postgres
PSQL_PWD=test
DEV_DB=bracketballer_dev
PSQL_HOST=localhost
PSQL_PORT=5432

# Required by CBBD ingestion jobs.
CBBD_API_KEY=replace-me

# Optional: pin the source revision recorded in data_import_runs.
PIPELINE_COMMIT=

# Optional sibling Fastify checkout override for schema-aware Git hooks.
# FASTIFY_REPO_PATH=../fastify

# Optional private DigitalOcean Spaces publishing (never commit real values).
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=bracketballer-development-snapshots
DO_SPACES_ACCESS_KEY_ID=
DO_SPACES_SECRET_ACCESS_KEY=
# DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
